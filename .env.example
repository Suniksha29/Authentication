# ==============================================================================
# Meridian Enterprise Portal - Environment Variables Configuration Template
# Copy this file to .env before starting the stack:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# Google Cloud Platform: OAuth 2.0 / OpenID Connect Credentials
# ------------------------------------------------------------------------------
# 1. Open Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Configure OAuth Consent Screen: User Type = External (or Internal if Workspace)
#    Scopes: openid, profile, email
# 3. Create OAuth 2.0 Client ID: Application Type = Web application
#    Authorized redirect URIs:
#      http://localhost:8080/login/oauth2/code/google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ------------------------------------------------------------------------------
# Meridian Identity & Authorization Policy
# ------------------------------------------------------------------------------
# Set this to YOUR personal or corporate Google email.
# On first boot, Meridian automatically initializes/promotes this email
# to ROLE_ADMIN and status ACTIVE, allowing immediate administrative access.
BOOTSTRAP_ADMIN_EMAIL=admin@meridian.internal

# Optional: Restrict logins to a specific Google Workspace hosted domain (the "hd" claim)
# Leave blank to allow any Google identity verified in the database.
# Example: ALLOWED_DOMAIN=yourcompany.com
ALLOWED_DOMAIN=

# Enable demo simulation in the Auth Flow Inspector (true/false)
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Relational Database (PostgreSQL)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=meridian
DB_USER=meridian_user
DB_PASSWORD=meridian_secure_pass_2026

# ------------------------------------------------------------------------------
# Distributed Session Cache (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=meridian_redis_pass_2026
SESSION_STORE_TYPE=redis

# ------------------------------------------------------------------------------
# Outbound Email Delivery (Google SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password

