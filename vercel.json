{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://authentication-uxbg.onrender.com/api/:path*"
    },
    {
      "source": "/oauth2/:path*",
      "destination": "https://authentication-uxbg.onrender.com/oauth2/:path*"
    },
    {
      "source": "/login/oauth2/:path*",
      "destination": "https://authentication-uxbg.onrender.com/login/oauth2/:path*"
    },
    {
      "source": "/actuator/:path*",
      "destination": "https://authentication-uxbg.onrender.com/actuator/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

